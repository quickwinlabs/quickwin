diff --git a/core/shared/platform/windows/win_socket.c b/core/shared/platform/windows/win_socket.c
index 8d61c45c..49108aba 100644
--- a/core/shared/platform/windows/win_socket.c
+++ b/core/shared/platform/windows/win_socket.c
@@ -4,6 +4,21 @@
  */
 
 #include "platform_api_vmcore.h"
+
+/* inet_pton is Vista+; XP fallback via WSAStringToAddress */
+static int inet_pton_xp(int af, const char *src, void *dst) {
+    if (af == AF_INET) {
+        struct sockaddr_in addr;
+        memset(&addr, 0, sizeof(addr));
+        addr.sin_family = AF_INET;
+        if (inet_addr(src) == INADDR_NONE) return 0;
+        addr.sin_addr.S_un.S_addr = inet_addr(src);
+        memcpy(dst, &addr.sin_addr, sizeof(struct in_addr));
+        return 1;
+    }
+    return 0;
+}
+#define inet_pton inet_pton_xp
 #include "platform_api_extension.h"
 #include "platform_wasi_types.h"
 #include "win_util.h"
