{
  "compilerOptions": {
    // "incremental": true,
    "target": "es2022",
    "module": "esnext",
    "strict": true,
    "noImplicitAny": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUncheckedSideEffectImports": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    // "skipLibCheck": true,
    "allowJs": false,
    "lib": ["ES2025"],
    "types": ["./quickwin.d.ts"],
    "rootDir": ".",
    "outDir": "_build",
    "jsx": "react-jsx",
    "jsxImportSource": "quickwin/lib/react-qw",
    // quickwin 自身不在 node_modules，jsxImportSource 的裸子路径靠 paths 指向本地文件；
    // 发布包里 lib/react-qw/jsx-runtime 天然可解析，消费方无需 paths
    "paths": {
      "quickwin/lib/react-qw/jsx-runtime": ["./lib/react-qw/jsx-runtime.d.ts"],
    },
  },
  "include": ["test/**/*.ts", "test/**/*.tsx", "examples/**/*.ts", "examples/**/*.tsx", "main.ts", "quickwin.d.ts", "lib/**/*.ts", "lib/**/*.tsx"],
  "exclude": []
}
