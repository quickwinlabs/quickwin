{
  "compilerOptions": {
    // "incremental": true,
    "target": "es2022",
    "module": "esnext",
    "strict": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    // "skipLibCheck": true,
    "allowJs": false,
    "lib": ["ES2020"],
    "types": ["./quickwin.d.ts"],
    "outDir": "_build",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
  },
  "include": ["test/**/*.ts", "test/**/*.tsx", "examples/**/*.ts", "examples/**/*.tsx", "main.ts", "quickwin.d.ts", "lib/**/*.ts", "lib/**/*.tsx"],
  "exclude": []
}
