FROM fedora:44

# 阿里云镜像加速（路径: download.example/pub/fedora/linux → mirrors.aliyun.com/fedora，注意无 /linux/ 层级）
RUN sed -e 's|^metalink=|#metalink=|g' \
        -e 's|^#baseurl=http://download.example/pub/fedora/linux|baseurl=https://mirrors.aliyun.com/fedora|g' \
        -i.bak \
        /etc/yum.repos.d/fedora*.repo && \
    sed -e 's|^enabled=1|enabled=0|g' \
        -i /etc/yum.repos.d/fedora-cisco-openh264.repo

RUN dnf install -y \
    # Build tools
    gcc gcc-c++ make cmake git pkgconfig \
    # Autotools (libffi 干净 checkout 需要 autoreconf -fiv)
    autoconf automake libtool libtool-ltdl-devel \
    # WABT (wat2wasm 编译 test/*.wat 为 wasm)
    wabt \
    # MinGW cross-compilers
    mingw64-gcc mingw64-gcc-c++ mingw64-winpthreads-static \
    mingw32-gcc mingw32-gcc-c++ mingw32-winpthreads-static \
    # Node.js
    nodejs npm \
    # QEMU for Windows testing (core only, no display/audio/block drivers)
    qemu-system-x86-core \
    qemu-img \
    # QEMU CI tools
    mtools dosfstools genisoimage socat \
    # Samba (smbd) for QEMU -netdev user,smb=
    samba \
    # noVNC for browser-based VNC access to QEMU VMs
    novnc python3-websockify \
    # Utilities
    curl wget zip unzip 7zip python3 dos2unix && \
    dnf clean all

WORKDIR /workspace
